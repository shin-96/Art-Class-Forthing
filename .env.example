# DrawPath AI — environment (copy to .env, server reads it at boot)
PORT=4173
# Admin seed (created only if no admin exists)
ADMIN_EMAIL=admin@drawpath.local
ADMIN_PASSWORD=Admin123!
# ---- Free AI providers (all optional; chain falls back in this order) ----
# 1. Google Gemini free tier (no card) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 2. OpenRouter :free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# 3. Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# 4. Z.ai GLM Flash free (incl. vision GLM-4.6V-Flash) — https://z.ai
ZAI_API_KEY=
ZAI_MODEL=glm-4.6v-flash
# 5. Mistral free Experiment — https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# 6. SambaNova free tier — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# 7. NVIDIA NIM free (rate limited) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# 8. Cloudflare Workers AI free 10k neurons/day — needs account id + token
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# 9. Pollinations — no key needed (text, heavily rate limited), always last cloud fallback
POLLINATIONS_ENABLED=1
# Generic override (wins over all above when set)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
